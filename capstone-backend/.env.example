PORT=5000

# Database Connections
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Transactional email. Use "resend" after the sending domain is verified.
EMAIL_PROVIDER=emailjs
RESEND_API_KEY=
RESEND_FROM_EMAIL="Pascualinga Hospital <no-reply@notify.pascualinga.com>"
PUBLIC_WEB_ORIGIN=https://pascualinga.com

# Temporary rollback provider during the Resend migration
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Supabase Storage & Realtime
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=avatars

AI_VERIFICATION_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# PayMongo (Video Consultation Payments)
# Optional production video provider. When all three are configured, the
# backend returns JaaS URLs with a moderator JWT for doctors and attendee JWT
# for patients. The patient app does not need any changes.
JAAS_APP_ID=
JAAS_KEY_ID=
JAAS_PRIVATE_KEY=
JITSI_BASE_URL=https://meet.jit.si
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_SUCCESS_URL=
PAYMONGO_CANCEL_URL=

# Video consultation slot generation (server-side)
VIDEO_SLOT_MINUTES=30
VIDEO_SLOTS_START=09:00
VIDEO_SLOTS_END=17:00
VIDEO_TIMEZONE_OFFSET=+08:00
VIDEO_CONSULT_PRICE_CENTS=50000
SESSION_SECRET=replace-with-a-long-random-secret
